# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and update with your values

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ==============================================================================
# GOOGLE MAPS CONFIGURATION
# ==============================================================================

# Google Maps API Key for location picker (per-km calculations)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps JavaScript API, Places API, Geocoding API
# If not provided, the app will automatically fallback to OpenStreetMap
VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# OPTIONAL SETTINGS
# ==============================================================================

# Google API Key (for other Google services if needed)
GOOGLE_API_KEY=
